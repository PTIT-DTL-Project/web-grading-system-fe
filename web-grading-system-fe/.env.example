# Frontend build-time configuration. Copy to .env / .env.production and fill in.
# Vite only exposes variables prefixed VITE_ to the bundle.
#
# VITE_KEYCLOAK_AUTHORITY — REQUIRED. Issuer base of the Keycloak realm the app
# signs in against; must have the exact form https://<host>/realms/<realm>
# (keycloakConfig() parses it, a mismatch throws KeycloakConfigError and the app
# cannot start). It must match the gateway's KEYCLOAK_ISSUER_URI, otherwise
# tokens the gateway validates differ from the ones this app requests.
VITE_KEYCLOAK_AUTHORITY=https://web-dev1-keycloak.vucongtuanduong.dpdns.org/realms/ptit-wgs

# VITE_KEYCLOAK_CLIENT_ID — Keycloak client for this SPA (public + PKCE, never
# confidential). Defaults to web-grading-fe when unset.
VITE_KEYCLOAK_CLIENT_ID=web-grading-fe

# VITE_API_PROXY_TARGET — dev only: where the Vite dev proxy forwards /api/**.
# Production must be same-origin (the FE host routes /api to the gateway); do not
# set this for a production build. Per-machine overrides: .env.development.local.
#VITE_API_PROXY_TARGET=http://localhost:30195
